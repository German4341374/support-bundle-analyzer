# Copy to .env for Docker Compose development. Values are intentionally non-secret placeholders.
SBA_ACCESS_TOKEN=replace-with-at-least-24-random-characters
SBA_ANALYSIS_TIMEOUT_SECONDS=900
SBA_RATE_LIMIT_MAX=120
SBA_EXPENSIVE_RATE_LIMIT_MAX=10
POSTGRES_DB=support_bundle_analyzer
POSTGRES_USER=sba
POSTGRES_PASSWORD=replace-with-a-long-local-development-password
