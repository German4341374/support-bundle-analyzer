{
  "name": "jvm-diagnostics-analyzer",
  "version": "0.1.0",
  "protocolVersion": "1",
  "executable": "java -jar jvm-diagnostics-analyzer.jar",
  "supportedArtifactTypes": ["jvm-thread-dump", "jvm-gc-log", "jvm-arguments", "jvm-properties", "jvm-heap-dump"],
