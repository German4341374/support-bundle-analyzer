{
  "name": "german4341374/php-web-diagnostics-analyzer",
  "description": "PHP and web-hosting diagnostics plugin for Universal Support Bundle Analyzer",
  "type": "project",
  "license": "Apache-2.0",
  "require": {
    "php": "^8.3 || ^8.4"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "3.95.22",
    "phpstan/phpstan": "2.2.9",
    "phpunit/phpunit": "11.5.56"
  },
  "autoload": {
    "psr-4": {
      "SupportBundleAnalyzer\\PhpWeb\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SupportBundleAnalyzer\\PhpWeb\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "check": [
      "@cs-check",
      "@phpstan",
      "@test"
    ],
    "cs-check": "php-cs-fixer check --diff",
    "phpstan": "phpstan analyse --no-progress",
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": false
  }
}
