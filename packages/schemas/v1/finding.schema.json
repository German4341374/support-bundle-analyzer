{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://support-bundle-analyzer.dev/schemas/v1/finding.schema.json",
  "title": "Finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "ruleId", "title", "severity", "category", "summary", "confidence", "evidence", "nextSteps"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "ruleId": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
    "title": { "type": "string", "minLength": 1 },
    "severity": { "enum": ["info", "low", "medium", "high", "critical"] },
    "category": { "type": "string", "minLength": 1 },
    "component": { "type": "string" },
    "summary": { "type": "string", "minLength": 1 },
    "explanation": { "type": "string" },
    "confidence": { "enum": ["exact", "strong", "heuristic"] },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifact"],
        "properties": {
          "artifact": { "type": "string" },
          "lineStart": { "type": "integer", "minimum": 1 },
          "lineEnd": { "type": "integer", "minimum": 1 },
          "jsonPointer": { "type": "string" },
          "timestamp": { "type": "string" },
          "excerpt": { "type": "string" }
        }
      }
    },
    "nextSteps": { "type": "array", "items": { "type": "string" } },
    "references": { "type": "array", "items": { "type": "string" } }
  }
}

